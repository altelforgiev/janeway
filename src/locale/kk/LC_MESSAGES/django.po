#: themes/clean/templates/core/accounts/reset_password.html:47
#: themes/material/templates/core/accounts/register.html:53
#: themes/material/templates/core/accounts/reset_password.html:43
msgid "Password Guide"
msgstr "Құпиясөз нұсқаулығы"

#: templates/admin/core/accounts/password_guide.html:15
msgid ""
"\n"
"        When it comes to passwords, length is better than complexity.\n"
"      "
msgstr "Құпия сөздерге келетін болсақ, күрделіліктен гөрі ұзындық жақсырақ."

#: templates/admin/core/accounts/password_guide.html:18
msgid ""
"\n"
"        Its a common myth that a short and complex password\n"
"        (Jfjfy&65^87) is more secure than a long and uncomplicated password\n"
"        (our awesome moon base rocks).\n"
"      "
msgstr ""
"Бұл қысқа және күрделі құпия сөз туралы кең таралған миф\n"
"        (Jfjfy&65^87) ұзақ және күрделі емес құпия сөзге қарағанда қауіпсіз\n"
"        (біздің керемет ай негізі жартастары)."

#: templates/admin/core/accounts/password_guide.html:23
msgid ""
"\n"
"        We recommend selecting a long, but easy to remember\n"
"        password such as our awesome moon base rocks which would take an\n"
"        estimated septillion years to crack as opposed to a complex one like\n"
"        Jfjfy&65^87 which would take just over 600 years on a standard\n"
"        computer.\n"
"      "
msgstr ""
"Ұзын, бірақ есте сақтау оңай таңдауды ұсынамыз\n"
"        Құпия сөз, мысалы, айдың ғажайып тастары\n"
"        септилион жылдарға есептелген күрделі кезеңнен айырмашылығы\n"
"        Jfjfy&65^87 стандарты бойынша 600 жылдан сәл астам уақытты алады\n"
"        компьютер."

