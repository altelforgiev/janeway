#: core/setting_strings.py:11
msgid "Altermetric Badge Type"
msgstr "Тип бейджа Altmetric"

#: core/setting_strings.py:12
msgid ""
"Select a badge type, 1, large-donut, large-bar etc. Defaults to '1' if none "
"selected."
msgstr ""
"Выберите тип бейджа: 1, large-donut, large-bar и т. д. Если ничего не "
"выбрано, используется «1»."

#: core/setting_strings.py:13
msgid "Disable article large image"
msgstr "Отключить большое изображение статьи"

#: core/setting_strings.py:14
msgid ""
"If checked, the article large image will not be displayed on the article page"
msgstr ""
"Если отмечено, большое изображение статьи не будет показываться на странице "
"статьи"

#: core/setting_strings.py:15
msgid "Disable article thumbnails"
msgstr "Отключить миниатюры статей"

#: core/setting_strings.py:16
msgid ""
"If checked, no article thumbnails will be rendered on public article lists"
msgstr ""
"Если отмечено, миниатюры статей не будут показываться в публичных списках "
"статей"

#: core/setting_strings.py:17
msgid "Display Altmetric Badges"
msgstr "Показывать бейджи Altmetric"

#: core/setting_strings.py:18
msgid "If enabled altmetric badges will be displayed in the sidebar."
msgstr "Если включено, бейджи Altmetric будут показываться на боковой панели."

#: core/setting_strings.py:19
msgid "Display Date Accepted"
msgstr "Показывать дату принятия"

#: core/setting_strings.py:20
msgid ""
"When enabled the date an article was accepted will be displayed on the "
"article page."
msgstr "Если включено, на странице статьи будет показываться дата её принятия."

#: core/setting_strings.py:21
msgid "Display Date Submitted"
msgstr "Показывать дату поступления"

#: core/setting_strings.py:22
msgid ""
"When enabled the date an article was submitted will be displayed on the "
"article page."
msgstr ""
"Если включено, на странице статьи будет показываться дата её поступления."

#: core/setting_strings.py:23
msgid "Display Guest Editors"
msgstr "Показывать приглашённых редакторов"

#: core/setting_strings.py:24
msgid ""
"If enabled guest editors will display on the article page for primary issues."
msgstr ""
"Если включено, приглашённые редакторы будут показываться на странице статьи "
"для основных выпусков."

#: core/setting_strings.py:25
msgid "Hide Author Email Links"
msgstr "Скрыть ссылки на e-mail авторов"

#: core/setting_strings.py:26
msgid ""
"If enabled the article page will not display links to email correspondence "
"authors."
msgstr ""
"Если включено, на странице статьи не будут показываться ссылки на e-mail "
"авторов для переписки."

#: core/setting_strings.py:27
msgid "Suppress Citation Metrics"
msgstr "Скрыть показатели цитирования"

#: core/setting_strings.py:28
msgid ""
"If enabled this will suppress the citations counter on the article page. The "
"citation block will only appear for articles that have a citation. This "
"setting is overruled by the Disable Metrics setting."
msgstr ""
"Если включено, счётчик цитирований на странице статьи будет скрыт. Блок "
"цитирований показывается только для статей, у которых есть цитирования. Эта "
"настройка перекрывается настройкой «Отключить метрики»."

#: core/setting_strings.py:29
msgid "Suppress How to Cite"
msgstr "Скрыть блок «Как цитировать»"

#: core/setting_strings.py:30
msgid ""
"If enabled this will suppress the how to cite block on the article page."
msgstr "Если включено, блок «Как цитировать» на странице статьи будет скрыт."

#: core/setting_strings.py:31
msgid "Enable Crosscheck"
msgstr "Включить Crosscheck"

#: core/setting_strings.py:32
msgid "If enabled, links to crosscheck reports will be displayed"
msgstr "Если включено, будут показываться ссылки на отчёты Crosscheck"

#: core/setting_strings.py:33
msgid "Password for crosscheck/ithenticate"
msgstr "Пароль Crosscheck/iThenticate"

#: core/setting_strings.py:34
msgid "Used to submit files for review"
msgstr "Используется для отправки файлов на проверку"

#: core/setting_strings.py:35
msgid "Username for crosscheck/ithenticate"
msgstr "Имя пользователя Crosscheck/iThenticate"

#: core/setting_strings.py:36
msgid "Crossref Date Suffix"
msgstr "Суффикс даты Crossref"

#: core/setting_strings.py:37
msgid "For migrated content where we need to tweak the crossref date."
msgstr ""
"Для перенесённого контента, где нужно скорректировать дату для Crossref."

#: core/setting_strings.py:38
msgid "Accepted Review Reminder"
msgstr "Напоминание о принятой рецензии"

#: core/setting_strings.py:39
msgid ""
"Notify reviewer of accepted request and remind them to review submission."
msgstr ""
"Уведомить рецензента о принятом запросе и напомнить о рецензировании "
"рукописи."

#: core/setting_strings.py:40
msgid "Author Copyediting Complete"
msgstr "Авторская проверка редактуры завершена"

#: core/setting_strings.py:41
msgid "Email sent to Editor when an author copyedit review is complete."
msgstr ""
"Письмо редактору о завершении авторской проверки литературной редактуры."

#: core/setting_strings.py:42
msgid "Author Copyedit Deleted"
msgstr "Авторская проверка редактуры удалена"

#: core/setting_strings.py:43
msgid ""
"Email sent to an author when an editor deletes their copyedit review task."
msgstr ""
"Письмо автору, когда редактор удаляет его задачу по проверке редактуры."

#: core/setting_strings.py:44
msgid "Author Publication Notification"
msgstr "Уведомление автора о публикации"

#: core/setting_strings.py:45
msgid "Notify the author of their publication date and time."
msgstr "Уведомить автора о дате и времени публикации."

#: core/setting_strings.py:46
msgid "Bounced Email Notification"
msgstr "Уведомление о недоставленном письме"

#: core/setting_strings.py:47
msgid "Email sent when an outgoing email bounces."
msgstr "Письмо, отправляемое, когда исходящее письмо не доставлено."

#: core/setting_strings.py:48
msgid "Conditional Accept"
msgstr "Условное принятие"

#: core/setting_strings.py:49
msgid ""
"Email sent to authors when sending a conditional accept revision request."
msgstr "Письмо авторам при запросе доработки с условным принятием."

#: core/setting_strings.py:50
msgid "Copyediting Request Deleted"
msgstr "Запрос на редактуру удалён"

#: core/setting_strings.py:51
msgid "Sent when a copyediting assignment is deleted."
msgstr "Отправляется при удалении задания на литературную редактуру."

#: core/setting_strings.py:52
msgid "Copyedit Acknowledge"
msgstr "Благодарность литературному редактору"

#: core/setting_strings.py:53
msgid "Email sent to Copyeditor to thank them."
msgstr "Письмо литературному редактору с благодарностью."

#: core/setting_strings.py:54
msgid "Copyedit Notify Copyeditor"
msgstr "Уведомление литературного редактора"

#: core/setting_strings.py:55
msgid "Email sent to copyeditors."
msgstr "Письмо литературным редакторам."

#: core/setting_strings.py:56
msgid "Copyedit Notify Author"
msgstr "Уведомление автора о редактуре"

#: core/setting_strings.py:57
msgid "Email sent to Author asking them to review copyedits."
msgstr "Письмо автору с просьбой проверить правки литературного редактора."

#: core/setting_strings.py:58
msgid "Copyedit Notify Editor"
msgstr "Уведомление редактора о редактуре"

#: core/setting_strings.py:59
msgid "Email sent to editor when copyedits are complete."
msgstr "Письмо редактору о завершении литературной редактуры."

#: core/setting_strings.py:60
msgid "Copyedit Reopen Task"
msgstr "Повторное открытие задачи редактуры"

#: core/setting_strings.py:61
msgid "Email sent to Copyeditor asking them to undertake further copyedits."
msgstr ""
"Письмо литературному редактору с просьбой выполнить дополнительную редактуру."

#: core/setting_strings.py:62
msgid "Copyediting Request Updated"
msgstr "Запрос на редактуру обновлён"

#: core/setting_strings.py:63
msgid "Sent when a copyediting assignment is updated."
msgstr "Отправляется при изменении задания на литературную редактуру."

#: core/setting_strings.py:64
msgid "Default Review Reminder"
msgstr "Стандартное напоминание о рецензии"

#: core/setting_strings.py:65
msgid "Email to remind reviewers of a new request."
msgstr "Письмо с напоминанием рецензентам о новом запросе."

#: core/setting_strings.py:66
msgid "Draft Decisions Editor Message"
msgstr "Сообщение редактору о проекте решения"

#: core/setting_strings.py:67
msgid "Email sent to the Editor when a section editor makes a draft decision."
msgstr "Письмо редактору, когда редактор раздела готовит проект решения."

#: core/setting_strings.py:68
msgid "Draft Decisions Message"
msgstr "Сообщение о проекте решения"

#: core/setting_strings.py:69
msgid "Email sent when a section editor makes a draft decision."
msgstr "Письмо, отправляемое, когда редактор раздела готовит проект решения."

#: core/setting_strings.py:70
msgid "Editor Assignment"
msgstr "Назначение редактора"

#: core/setting_strings.py:71
msgid "Email sent to editors when they are assigned to a submission."
msgstr "Письмо редакторам о назначении на рукопись."

#: core/setting_strings.py:72
msgid "Editor Digest"
msgstr "Сводка для редактора"

#: core/setting_strings.py:73
msgid "Digest email sent to editors.."
msgstr "Сводное письмо для редакторов."

#: core/setting_strings.py:74
msgid "New Submission for Editor"
msgstr "Новая рукопись для редактора"

#: core/setting_strings.py:75
msgid "Email sent to the Editor when there is a new submission."
msgstr "Письмо редактору о поступлении новой рукописи."

#: core/setting_strings.py:76
msgid "New User Registration"
msgstr "Регистрация нового пользователя"

#: core/setting_strings.py:77
msgid "Email sent when user registers."
msgstr "Письмо, отправляемое при регистрации пользователя."

#: core/setting_strings.py:78
msgid "Submission Notification"
msgstr "Уведомление о рукописи"

#: core/setting_strings.py:79
msgid "Send to a user specified in notification manager."
msgstr "Отправляется пользователю, указанному в менеджере уведомлений."

#: core/setting_strings.py:80
msgid "Correction Task Cancelled"
msgstr "Задача по исправлениям отменена"

#: core/setting_strings.py:81
msgid "Email sent when an Editor cancels or deletes a correction task."
msgstr ""
"Письмо, отправляемое, когда редактор отменяет или удаляет задачу по "
"исправлениям."

#: core/setting_strings.py:82
msgid "Notify Editor that Proofreading is Complete"
msgstr "Уведомить редактора о завершении корректуры"

#: core/setting_strings.py:83
msgid "Email sent to the Editor when Proofing is complete."
msgstr "Письмо редактору о завершении корректуры."

