msgstr "Включите, чтобы показать, что журнал использует плагин Isolinear."

#: core/setting_strings.py:495
msgid "Crossref depositor email"
msgstr "E-mail депозитора Crossref"

#: core/setting_strings.py:496
msgid "The email of the depositor for this journal on Crossref's system."
msgstr "Адрес e-mail депозитора этого журнала в системе Crossref."

#: core/setting_strings.py:497
